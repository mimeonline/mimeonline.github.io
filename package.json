{
  "name": "profile",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "astro build",
    "check": "astro check",
    "check:links": "pnpm dlx linkinator dist/index.html --silent --timeout 10000",
    "audit:lighthouse": "pnpm dlx @lhci/cli autorun --config=.lighthouserc.json",
    "quality": "pnpm run lint && pnpm run prettier && pnpm run check",
    "prepush": "pnpm run clean && pnpm run quality && pnpm run build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.0",
    "astro": "^5.17.1",
    "daisyui": "^5.5.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@tailwindcss/vite": "^4.1.18",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
