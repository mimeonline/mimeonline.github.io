---
import { Image } from 'astro:assets';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../content/site';
import Layout from '../layouts/layout.astro';
import profilePic from '../images/MichaelMeierhoff_4MB.jpg';
---

<Layout>
  <div class="mx-auto mb-4 h-80 w-80 overflow-hidden rounded-full border-4 border-gray-500">
    <Image
      src={profilePic}
      alt="Profilbild"
      class="h-full w-full object-cover"
      width={600}
      height={600}
      format="jpg"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <h1 class="mb-6 text-2xl font-bold">{site.hero.heading}</h1>
  <p class="mx-auto mb-8 max-w-xl text-center leading-relaxed text-gray-300">
    {site.hero.intro}
  </p>

  <SocialLinks />
</Layout>
